# =====================================================================
#  AISEKI 環境変数のひな形
#  .env にコピーして、値を埋めて使う（.env は git に含めない）
#  本番は Vercel のプロジェクト設定 → Environment Variables に登録する。
# =====================================================================

# ── Supabase（ブラウザから使う。VITE_ が付いた値は公開される） ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Supabase（サーバ /api からのみ使う。絶対に公開しない） ──
# service_role は RLS を迂回できる。VITE_ を付けてはいけない。
# Webhook でポイントを付与するために必要。
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 省略時は VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY を使う
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

# ── Stripe（まずはテストモードで） ──
# https://dashboard.stripe.com/test/apikeys
# pk_ と sk_ は同じアカウント・同じモードのものを組みで使う。
# 公開可能キーはブラウザ（カード登録の Stripe Elements）で使うので VITE_ を付ける。
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook の署名シークレット
#   ローカル: stripe listen --forward-to localhost:3000/api/stripe/webhook
#   本番:     Stripe ダッシュボードで /api/stripe/webhook を登録して取得
#   送るイベントに setup_intent.succeeded を含める（カード登録ボーナスの付与）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# 決済後の戻り先。未設定ならリクエストの Host から組み立てる。
# PUBLIC_BASE_URL=https://aiseki.example.com

# ── CAPTCHA（Cloudflare Turnstile）──
# カード登録ボーナス 5,000pt の自動登録による量産を防ぐ。
#   /api/stripe/setup-intent が Cloudflare に問い合わせて検証し、
#   通ったものにだけ印を押す（印が無いとボーナスは付かない）。
# 🚨 TURNSTILE_SECRET_KEY が未設定だとカード登録は 503 で止まる（意図した挙動）。
# サイトキーはブラウザに配るので VITE_ を付ける。シークレットには絶対に付けない。
#
# 下の値は Cloudflare が公開しているテスト用（常に成功する）。
# 本番キーは https://dash.cloudflare.com → Turnstile でサイトを追加して発行する。
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Twilio Verify（SMS電話番号認証）──
# メール確認 → 初回ログイン → SMS認証 → 参加許可（HANDOFF §28）。
#   /api/sms/start がコードを送り、/api/sms/check が照合する。
#   OTP は Twilio が持つので、こちらのDBにコードは保存しない。
# 🚨 AUTH_TOKEN に VITE_ を絶対に付けない（ブラウザに配信される）。
# 🚨 未設定だと /api/sms/status が enabled:false を返し、画面は認証の案内を出さない。
#   このとき DB 側の関門（assert_phone_verified）だけが残るので、
#   利用者は会の作成・お申し込みが一切できなくなる。設定を消すときは注意。
#
# VERIFY_SERVICE_SID は次のコマンドが作る（既にあれば作り直さない）:
#   node scripts/setup_twilio_verify.mjs
# ⚠ Twilio のトライアルアカウントでは、Twilio 側で検証していない番号に
#   SMS が届かない。本番運用の前にアップグレードすること。
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 管理者パスワード（運営画面 /admin/dm の2段目）──
# ログインしているメールアドレス（api/_lib.js の ADMIN_EMAILS）に加えて、
# もう1段この合言葉を要求する。照合は /api/admin/gate（サーバ側だけ）。
#   通ると 8時間ぶんの証明が返り、以後 /api/dm/* に x-admin-unlock で付く。
#   証明は sessionStorage にしか置かないので、タブを閉じれば入力し直しになる。
# 🚨 VITE_ を絶対に付けない（ブラウザに配信されてしまう）。
# 🚨 未設定だと /api/dm/* は 503 で止まる（fail closed。素通しにはならない）。
# ⚠ この値を変えると、発行済みの証明はすべて無効になる（署名鍵がこれだから）。
ADMIN_PASSWORD=changeme-admin-password
